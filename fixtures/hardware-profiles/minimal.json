{
  "schema": 1,
  "target": {
    "id": "twin-c3",
    "chip": "esp32c3"
  },
  "build": {
    "provider": "platformio",
    "workspace": ".",
    "environment": "native",
    "artifact": "build/firmware.elf"
  },
  "twin": {
    "provider": "labwired-sim",
    "system": "systems/c3.json",
    "artifactRelation": "exact"
  },
  "observations": [
    {
      "id": "heartbeat",
      "provider": "serial",
      "contains": "alive",
      "timeoutSeconds": 12,
      "requiredLevel": "model_observed"
    }
  ]
}
