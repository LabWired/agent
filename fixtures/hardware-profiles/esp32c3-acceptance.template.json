{
  "schema": 1,
  "target": {
    "id": "${TARGET_ID}",
    "chip": "esp32c3",
    "probeSerial": "${PROBE_SERIAL}",
    "serialPort": "${SERIAL_PORT}"
  },
  "build": {
    "provider": "platformio",
    "workspace": ".",
    "environment": "esp32-c3-devkitm-1",
    "artifact": ".pio/build/esp32-c3-devkitm-1/firmware.bin",
    "timeoutSeconds": 30
  },
  "twin": {
    "provider": "labwired-sim",
    "system": "system.yaml",
    "artifactRelation": "exact",
    "timeoutSeconds": 10
  },
  "flash": {
    "provider": "platformio",
    "timeoutSeconds": 30
  },
  "observations": [
    {
      "id": "heartbeat",
      "provider": "serial",
      "contains": "alive",
      "timeoutSeconds": 5,
      "requiredLevel": "hardware_observed"
    },
    {
      "id": "led",
      "provider": "logic-csv",
      "channel": 0,
      "timeColumn": "time_s",
      "valueColumn": "gpio8",
      "captureProvider": "sigrok-cli",
      "instrumentId": "${LOGIC_INSTRUMENT_ID}",
      "driver": "${LOGIC_DRIVER}",
      "sourceChannel": "D0",
      "sampleRateHz": 1000,
      "durationSeconds": 3,
      "edgeCountAtLeast": 4,
      "frequencyMinHz": 0.9,
      "frequencyMaxHz": 1.1,
      "requiredLevel": "hardware_observed"
    },
    {
      "id": "wifi",
      "provider": "network",
      "deviceMarker": "WIFI_READY",
      "hostProbeUrlFromMarker": "DEVICE_ADDR",
      "hostProbePath": "/health",
      "timeoutSeconds": 5,
      "requiredLevel": "hardware_observed"
    }
  ]
}
