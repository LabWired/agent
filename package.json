{
  "name": "@labwired/agent",
  "version": "0.3.7",
  "description": "LabWired Agent \u2014 portable verified firmware agent for macOS, Linux, and Windows",
  "license": "MIT",
  "homepage": "https://labwired.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LabWired/agent.git"
  },
  "bugs": {
    "url": "https://github.com/LabWired/agent/issues"
  },
  "keywords": [
    "labwired",
    "firmware",
    "embedded",
    "agent",
    "mcp",
    "opencode"
  ],
  "bin": {
    "labwired-agent-install": "scripts/npm-install.js"
  },
  "files": [
    "scripts/npm-install.js",
    "scripts/agent-install.sh",
    "scripts/agent-install.ps1",
    "scripts/install.ps1",
    "scripts/pack-portable.sh",
    "scripts/public/install",
    "scripts/public/install.ps1",
    "scripts/public/DEPLOY.md",
    "bin",
    "config",
    "skills",
    "lib",
    "branding",
    "install.sh",
    "demo.sh",
    "docs/PORTABLE_INSTALL.md",
    "VERSION",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node scripts/npm-install.js --postinstall || true",
    "test": "bash tests/all.sh",
    "test:unit": "bash tests/harness.sh && bash tests/skills-inventory.sh && bash tests/public-install.sh && bash tests/prefix-unit.sh",
    "test:dispatcher": "bash tests/dispatcher.sh",
    "test:agent-lifecycle": "bash tests/agent-lifecycle.sh",
    "test:public-install-safety": "bash tests/public-install-safety.sh",
    "test:install": "bash tests/install-smoke.sh",
    "test:llm": "bash tests/llm-deepinfra.sh"
  },
  "publishConfig": {
    "access": "public"
  }
}
