{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "labwired": {
      "type": "local",
      "command": ["npx", "-y", "@labwired/mcp"],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "LABWIRED_CLI": "{env:LABWIRED_CLI}",
        "LABWIRED_BUILDER_URL": "{env:LABWIRED_BUILDER_URL}"
      }
    }
  },
  "permission": {
    "skill": {
      "verify-firmware": "allow",
      "diagnose-firmware": "allow",
      "inspect-evidence": "allow",
      "board-bringup": "allow",
      "scaffold-firmware": "allow",
      "report-evidence": "allow"
    }
  },
  "provider": {
    "labwired-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LabWired (local)",
      "options": {
        "baseURL": "{env:LABWIRED_MODEL_URL}",
        "apiKey": "{env:LABWIRED_MODEL_KEY}"
      },
      "models": {
        "qwen2.5-coder": { "name": "Qwen2.5-Coder" }
      }
    }
  },
  "model": "labwired-local/qwen2.5-coder",
  "autoupdate": false,
  "share": "disabled",
  "agent": {
    "labwired": {
      "description": "LabWired Firmware Agent — the easiest way to write firmware. Writes firmware and checks it on a virtual board.",
      "mode": "primary"
    }
  },
  "default_agent": "labwired"
}
