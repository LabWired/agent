{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "labwired": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@labwired/mcp"
      ],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "LABWIRED_CLI": "{env:LABWIRED_CLI}",
        "LABWIRED_BUILDER_URL": "{env:LABWIRED_BUILDER_URL}",
        "LABWIRED_API": "http://127.0.0.1:0"
      }
    }
  },
  "permission": {
    "skill": {
      "board-bringup": "allow",
      "brainstorming": "allow",
      "bringup": "allow",
      "compose-observability": "allow",
      "desk-hw": "allow",
      "diagnose-firmware": "allow",
      "dispatching-parallel-agents": "allow",
      "executing-plans": "allow",
      "finishing-a-development-branch": "allow",
      "firmware-repair-loop": "allow",
      "flash-firmware": "allow",
      "golden-path": "allow",
      "hw-promote": "allow",
      "inspect-evidence": "allow",
      "observe": "allow",
      "part-knowledge": "allow",
      "prove": "allow",
      "receiving-code-review": "allow",
      "report-evidence": "allow",
      "requesting-code-review": "allow",
      "scaffold-firmware": "allow",
      "subagent-driven-development": "allow",
      "systematic-debugging": "allow",
      "test-driven-development": "allow",
      "using-git-worktrees": "allow",
      "using-superpowers": "allow",
      "verification-before-completion": "allow",
      "verify-firmware": "allow",
      "writing-plans": "allow",
      "writing-skills": "allow"
    }
  },
  "provider": {
    "labwired-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LabWired (on-prem)",
      "options": {
        "baseURL": "{env:LABWIRED_MODEL_URL}",
        "apiKey": "{env:LABWIRED_MODEL_KEY}"
      },
      "models": {
        "qwen2.5-coder": {
          "name": "LabWired \u00b7 Qwen2.5-Coder"
        }
      }
    }
  },
  "model": "labwired-local/qwen2.5-coder",
  "enabled_providers": [
    "labwired-local"
  ],
  "autoupdate": false,
  "share": "disabled",
  "agent": {
    "labwired": {
      "name": "LabWired Agent",
      "description": "Write firmware and run it on a virtual board. On-prem.",
      "mode": "primary",
      "color": "#0056b3"
    }
  },
  "default_agent": "labwired"
}
