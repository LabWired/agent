{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "labwired": {
      "type": "local",
      "command": ["npx", "-y", "@labwired/mcp"],
      "enabled": true,
      "environment": {
        "LABWIRED_CLI": "labwired",
        "LABWIRED_BUILDER_URL": "{env:LABWIRED_BUILDER_URL}",
        "LABWIRED_API": "http://127.0.0.1:0"
      }
    }
  },
  "provider": {
    "labwired-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LabWired (on-prem)",
      "options": {
        "baseURL": "{env:LABWIRED_MODEL_URL}",
        "apiKey": "{env:LABWIRED_MODEL_KEY}"
      },
      "models": {
        "qwen2.5-coder": { "name": "Qwen2.5-Coder" }
      }
    }
  },
  "model": "labwired-local/qwen2.5-coder",
  "enabled_providers": ["labwired-local"],
  "autoupdate": false,
  "share": "disabled",
  "agent": {
    "labwired": {
      "description": "LabWired firmware agent (on-prem) — proposes firmware, proves it with the deterministic hardware oracle.",
      "mode": "primary"
    }
  },
  "default_agent": "labwired"
}
