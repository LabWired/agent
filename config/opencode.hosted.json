{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "labwired": {
      "type": "remote",
      "url": "https://api.labwired.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LABWIRED_ACCESS_TOKEN}"
      }
    }
  },
  "permission": {
    "skill": {
      "brainstorming": "allow",
      "bringup": "allow",
      "desk-hw": "allow",
      "dispatching-parallel-agents": "allow",
      "executing-plans": "allow",
      "finishing-a-development-branch": "allow",
      "golden-path": "allow",
      "observe": "allow",
      "prove": "allow",
      "receiving-code-review": "allow",
      "requesting-code-review": "allow",
      "subagent-driven-development": "allow",
      "systematic-debugging": "allow",
      "test-driven-development": "allow",
      "using-git-worktrees": "allow",
      "using-superpowers": "allow",
      "verification-before-completion": "allow",
      "writing-plans": "allow",
      "writing-skills": "allow"
    }
  },
  "provider": {
    "labwired": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LabWired",
      "options": {
        "baseURL": "https://api.labwired.com/v1",
        "apiKey": "{env:LABWIRED_ACCESS_TOKEN}",
        "headers": {
          "X-LabWired-Project": "{env:LABWIRED_PROJECT}"
        }
      },
      "models": {
        "labwired-default": {
          "name": "LabWired \u00b7 Default"
        },
        "labwired-fast": {
          "name": "LabWired \u00b7 Fast"
        }
      }
    }
  },
  "model": "labwired/labwired-default",
  "autoupdate": false,
  "share": "disabled",
  "agent": {
    "labwired": {
      "name": "LabWired Agent",
      "description": "START with skill golden-path for firmware. Packs: bringup (MCP part/datasheet), prove (labwired_verify only mints model_verified), observe (labwired compose), desk-hw. Superpowers process is secondary. Never invent pins or green.",
      "mode": "primary",
      "color": "#0056b3"
    }
  },
  "default_agent": "labwired"
}
