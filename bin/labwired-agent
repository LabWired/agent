labwired_agent_remove_owned_config() {
  local cfg manifest entry path current part
  cfg="${OPENCODE_CONFIG_DIR:-${LABWIRED_AGENT_CONFIG_DIR:-$HOME/.config/labwired-agent}}"
  manifest="$cfg/labwired-agent.manifest"
  [[ ! -L "$cfg" && ! -L "$manifest" ]] || fail "refusing symlinked agent config ownership path"
  [[ -f "$manifest" ]] || return 0

  # Validate all manifest parent directories before changing anything. A file
  # entry may itself be a symlink (removing the link is safe), but cleanup must
  # never descend through one.
  for path in "$cfg/skills" "$cfg/branding"; do
    [[ ! -L "$path" ]] || fail "refusing symlinked agent config ownership ancestor: $path"
  done
  while IFS= read -r entry; do
    [[ -n "$entry" && "$entry" != json:* ]] || continue
    [[ "$entry" != "opencode.json" ]] || continue
    case "$entry" in /*|*..*|.|"" ) fail "unsafe agent ownership entry: $entry" ;; esac
    current="$cfg"
    IFS='/' read -r -a _labwired_owned_parts <<<"$entry"
    for part in "${_labwired_owned_parts[@]:0:${#_labwired_owned_parts[@]}-1}"; do
      current="$current/$part"
      [[ ! -L "$current" ]] || fail "refusing symlinked agent config ownership ancestor: $current"
    done
  done <"$manifest"

  # Remove only JSON paths recorded by the installer, pruning empty parents.
  python3 - "$cfg/opencode.json" "$manifest" <<'PY'
import json, os, sys, tempfile
config, manifest = sys.argv[1:]
if not os.path.isfile(config) or os.path.islink(config):
    sys.exit(0)
with open(manifest) as f:
    paths = [line.strip()[5:].split(".") for line in f if line.startswith("json:")]
with open(config) as f:
    data = json.load(f)
for parts in paths:
    parents = []
    node = data
    for part in parts[:-1]:
        if not isinstance(node, dict) or part not in node:
            break
        parents.append((node, part))
        node = node[part]
    else:
        if isinstance(node, dict):
            node.pop(parts[-1], None)
        for parent, key in reversed(parents):
            if isinstance(parent.get(key), dict) and not parent[key]:
                parent.pop(key)
            else:
                break
fd, tmp = tempfile.mkstemp(prefix=".opencode.", dir=os.path.dirname(config))
with os.fdopen(fd, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, config)
PY

  while IFS= read -r entry; do
    [[ -n "$entry" && "$entry" != json:* ]] || continue
    [[ "$entry" != "opencode.json" ]] || continue
    case "$entry" in /*|*..*|.|"" ) fail "unsafe agent ownership entry: $entry" ;; esac
    path="$cfg/$entry"
    [[ "$path" == "$cfg/"* ]] || fail "unsafe agent ownership entry: $entry"
    if [[ -f "$path" || -L "$path" ]]; then rm -f "$path"; fi
  done <"$manifest"
  rm -f "$manifest"
  find "$cfg/skills" "$cfg/branding" -depth -type d -empty -delete 2>/dev/null || true
}

labwired_agent_preserve_shared_dispatcher() {
  local h dispatcher core tmp
  h="$(labwired_prefix_home)"
  dispatcher="$h/bin/labwired"
  core="$h/components/core/bin/labwired"
  labwired_prefix_validate_path_ancestors "$h/bin" || fail "unsafe dispatcher path"
  if [[ -x "$core" || -d "$h/components/editor" ]]; then
    mkdir -p "$h/bin"
    labwired_prefix_validate_path_ancestors "$h/bin" || fail "unsafe dispatcher path"
    tmp="$(mktemp "$h/bin/.labwired-dispatcher.XXXXXX")"
    [[ -f "$tmp" && ! -L "$tmp" ]] || fail "could not create safe dispatcher"
    cat >"$tmp" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
h="${LABWIRED_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
core="$h/components/core/bin/labwired"
editor="$h/components/editor/bin/labwired-editor"
[[ -x "$editor" ]] || editor="$h/components/editor/bin/labwired"
case "${1:-}" in
  agent)
    if [[ "${2:-}" == package && "${3:-}" == uninstall && "${4:-}" == --yes ]]; then exit 0; fi
    echo 'labwired: Agent is not installed.' >&2; exit 1
    ;;
  core) shift; [[ -x "$core" ]] || { echo 'labwired: Core is not installed.' >&2; exit 1; }; exec "$core" "$@" ;;
  editor) shift; [[ -x "$editor" ]] || { echo 'labwired: Editor is not installed.' >&2; exit 1; }; exec "$editor" "$@" ;;
  ""|help|--help|-h) printf 'LabWired components: core%s\n' "$([[ -x "$editor" ]] && printf ' editor')" ;;
  *) [[ -x "$core" ]] || { echo "labwired: unknown command: $1" >&2; exit 2; }; exec "$core" "$@" ;;
esac
SH
    chmod 0755 "$tmp"
    labwired_prefix_validate_path_ancestors "$h/bin" || { rm -f "$tmp"; fail "unsafe dispatcher path"; }
    mv -f "$tmp" "$dispatcher"
  else
    rm -f "$dispatcher" "$h/bin/labwired-shim"
    if grep -q 'LabWired portable launcher' "$(labwired_user_bin)/labwired" 2>/dev/null; then
      rm -f "$(labwired_user_bin)/labwired"
    fi
  fi
}

cmd_package() {
  local sub="${1:-info}"
  shift || true
  case "$sub" in
    info|show)
      labwired_prefix_info
      ;;
    path|home)
      echo "$(labwired_prefix_home)"
      ;;
    env)
      cat "$(labwired_prefix_home)/env.sh" 2>/dev/null || fail "no env.sh — run install"
      ;;
    uninstall)
      local h
      h="$(labwired_prefix_home)"
      case "$h" in /*) ;; *) fail "refusing unsafe relative prefix" ;; esac
      labwired_prefix_validate_path_ancestors "$h" || fail "refusing symlinked prefix ancestor"
      if [[ "$h" == "/" || -z "$h" || "$h" == "$HOME" || -L "$h" ]]; then
        fail "refusing to uninstall empty/root prefix"
      fi
      echo "This removes the portable prefix: $h"
      echo "User shim: $(labwired_user_bin)/labwired"
      if [[ "${1:-}" != "--yes" ]]; then
        fail "re-run: labwired agent package uninstall --yes"
      fi
      if [[ -L "$h/state" || ( -e "$h/state" && ! -d "$h/state" ) ]]; then
        fail "refusing symlinked or invalid Agent state ancestor: $h/state"
      fi
      labwired_agent_remove_owned_config
      labwired_agent_preserve_shared_dispatcher
      labwired_prefix_validate_path_ancestors "$h" || fail "refusing symlinked prefix ancestor"
      [[ ! -L "$h/state" ]] || fail "refusing symlinked Agent state ancestor: $h/state"
      rm -rf "$h/agent" "$h/state/agent"
      say "uninstalled Agent from $h"
      ;;
    *)
      cat <<'EOF'
labwired agent package — manage portable install

  labwired agent package info       Show prefix, platform, MANIFEST
  labwired agent package path       Print LABWIRED_HOME
  labwired agent package env        Print env.sh
  labwired agent package uninstall --yes
                              Remove Agent-owned files and configuration
EOF
      return 2
      ;;
  esac
}

cmd_assert_status() {
  local expected="${1:-}"
  local file="${2:-}"
  if [[ -z "$expected" ]]; then
    fail "usage: labwired agent assert-status <expected> [file]"
  fi
  # shellcheck source=lib/assert-status.sh
  source "$ROOT/lib/assert-status.sh"
  if [[ -n "$file" && "$file" != "-" ]]; then
    labwired_assert_status "$expected" <"$file"
  else
    labwired_assert_status "$expected"
  fi
}

cmd_score_verify() {
  # shellcheck source=lib/score-verify.sh
  source "$ROOT/lib/score-verify.sh"
  labwired_score_verify "$@"
}

cmd_serial_capture() {
  # shellcheck source=lib/serial-capture.sh
  source "$ROOT/lib/serial-capture.sh"
  labwired_serial_capture "$@"
}

case "${1:-}" in
  server)
    shift
    # Headless JSON-RPC for IDE clients (Electron, VS Code extension)
    rpc="$ROOT/server/rpc-server.mjs"
    if [[ ! -f "$rpc" ]]; then
      fail "rpc-server.mjs missing at $rpc"
    fi
    if [[ "${1:-}" == "--rpc-stdio" || "${1:-}" == "" || "${1:-}" == "--stdio" ]]; then
      shift || true
      exec node "$rpc" "$@"
    fi
    # Optional: forward to agent runtime serve for HTTP
    if [[ "${1:-}" == "--http" ]]; then
      shift
      if command -v opencode >/dev/null 2>&1; then
        export OPENCODE_DISABLE_TERMINAL_TITLE=1
        labwired_set_window_title "LabWired Agent"
        exec -a labwired-agent "$(command -v opencode)" serve "$@"
      fi
      fail "LabWired Agent runtime not found for --http — re-run install"
    fi
    exec node "$rpc" "$@"
    ;;
  login|connect) shift; cmd_login "$@" ;;
  logout)  shift; cmd_logout "$@" ;;
  whoami)  shift; cmd_whoami "$@" ;;
  auth|providers)
    # Intercept LabWired Agent runtime engine auth/providers so product never shows third-party model marketplaces.
    shift
    cmd_auth "$@"
    ;;
  doctor)  shift; cmd_doctor "$@" ;;
  install-deps|deps)
    shift
    cmd_install_deps "$@"
    ;;
  update|self-update|upgrade)
    shift
    cmd_update "$@"
    ;;
  smoke|check|hello)
    shift
    cmd_smoke "$@"
    ;;
  package|pkg)
    shift
    cmd_package "$@"
    ;;
  version|--version|-V) cmd_version ;;
  help|--help|-h) cmd_help ;;
  assert-status)
    shift
    cmd_assert_status "$@"
    ;;
  score-verify)
    shift
    cmd_score_verify "$@"
    ;;
  serial-capture)
    shift
    cmd_serial_capture "$@"
    ;;
  compose)
    shift
    cmd_compose "$@"
    ;;
  probe)
    shift
    labwired_probe_cmd "$@"
    ;;
  agent|opencode)
    # Internal runtime alias — same product start as bare `labwired agent`.
    shift || true
    if [[ -n "${LABWIRED_HOME:-}" && -d "${LABWIRED_HOME}/bin" ]]; then
      export PATH="${LABWIRED_HOME}/bin:${PATH}"
    fi
    if ! command -v opencode >/dev/null 2>&1; then
      fail "LabWired Agent runtime not found. Re-run: curl -fsSL https://labwired.com/install | bash"
    fi
    # First start: LabWired account login.
    labwired_ensure_account
    labwired_prepare_agent_start
    if [[ "${LABWIRED_PROFILE:-}" != "hosted" ]]; then
      labwired_export_sim || true
    fi
    labwired_splash
    echo "labwired: starting LabWired Agent — skill develop; guide golden-path; packs bringup/prove/observe/desk-hw/import-circuit" >&2
    echo "labwired: LabWired Agent · twin tools via MCP labwired_* · compose: labwired agent compose …" >&2
    labwired_exec_opencode "$@"
    ;;
  "")
    # Ensure prefix tools visible for this session
    if [[ -n "${LABWIRED_HOME:-}" && -d "${LABWIRED_HOME}/bin" ]]; then
      export PATH="${LABWIRED_HOME}/bin:${PATH}"
    fi
    if ! command -v opencode >/dev/null 2>&1; then
      fail "LabWired Agent runtime not found. Re-run: curl -fsSL https://labwired.com/install | bash"
    fi
    # First start: LabWired account login.
    labwired_ensure_account
    labwired_prepare_agent_start
    if [[ "${LABWIRED_PROFILE:-}" != "hosted" ]]; then
      if labwired_export_sim; then
        :
      else
        # No local sim is fine — debugger / probe path is first-class.
        echo "labwired: note — no local sim (optional)." >&2
        echo "         twin: labwired agent login  (hosted tools)  or  labwired agent update --tools-only" >&2
        echo "         or use LabWired debugger / probe-rs — sim is not required" >&2
      fi
    fi
    labwired_splash
    echo "labwired: starting LabWired Agent — skill develop (firmware first); guide golden-path" >&2
    echo "labwired: start-here: account login → doctor → labwired agent → “blink and prove it”" >&2
    labwired_exec_opencode "$@"
    ;;
  *)
    # Pass through to agent runtime (e.g. labwired agent mcp list)
    # Never pass auth/connect/providers — those are product-owned (see cmd_auth).
    case "${1:-}" in
      auth|providers|connect|login|logout)
        cmd_auth "${1}" "${@:2}"
        exit $?
        ;;
    esac
    if ! command -v opencode >/dev/null 2>&1; then
      fail "LabWired Agent runtime not found on PATH. Re-run install first."
    fi
    if labwired_cloud_hosted_ready 2>/dev/null; then
      labwired_prepare_agent_start || true
    else
      labwired_export_sim || true
    fi
    labwired_exec_opencode "$@"
    ;;
esac
