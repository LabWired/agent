#!/usr/bin/env bash
# LabWired Agent — write firmware, run on a virtual board.
set -euo pipefail

# Optional overrides only — do NOT default to local Ollama.
# Hosted path uses session from `labwired agent login` (api.labwired.com).
# Local/BYO: export LABWIRED_MODEL_URL + LABWIRED_MODEL_KEY yourself.
export LABWIRED_BUILDER_URL="${LABWIRED_BUILDER_URL:-}"
# Simulator / oracle CLI the MCP shells out to (NOT this launcher).
# Resolved only when a real binary exists — never invent "labwired-cli".

# Official OpenCode pin (npm opencode-ai). Single upgrade knob — keep install.sh in sync.
# Policy: pin + wrap only; never fork. See docs/UPSTREAM_OPENCODE.md.
OPENCODE_PIN="${OPENCODE_PIN:-1.18.7}"

# Product home resolution (branded LabWired install)
# Prefer the kit that owns this bin/ when it is complete (so a checkout of
# labwired-agent wins over a stale ~/.labwired/agent without cloud-session).
# Order: script sibling kit → LABWIRED_AGENT_HOME → ~/.labwired/agent
_labwired_find_root() {
  local cand
  cand="$(cd "$(dirname "$0")/.." && pwd)"
  if [[ -f "$cand/lib/resolve-sim.sh" && -f "$cand/config/opencode.json" ]]; then
    echo "$cand"
    return 0
  fi
  if [[ -n "${LABWIRED_AGENT_HOME:-}" && -f "${LABWIRED_AGENT_HOME}/lib/resolve-sim.sh" ]]; then
    echo "${LABWIRED_AGENT_HOME}"
    return 0
  fi
  if [[ -f "$cand/lib/resolve-sim.sh" ]]; then
    echo "$cand"
    return 0
  fi
  cand="${HOME}/.labwired/agent"
  if [[ -f "$cand/lib/resolve-sim.sh" ]]; then
    echo "$cand"
    return 0
  fi
  echo "$(cd "$(dirname "$0")" && pwd)"
}

ROOT="$(_labwired_find_root)"
export LABWIRED_AGENT_HOME="$ROOT"

# shellcheck source=lib/prefix.sh
source "$ROOT/lib/prefix.sh"
# shellcheck source=lib/resolve-sim.sh
source "$ROOT/lib/resolve-sim.sh"
# shellcheck source=lib/resolve-probe.sh
source "$ROOT/lib/resolve-probe.sh"
# shellcheck source=lib/probe.sh
source "$ROOT/lib/probe.sh"
# shellcheck source=lib/cloud-session.sh
if [[ -f "$ROOT/lib/cloud-session.sh" ]]; then
  source "$ROOT/lib/cloud-session.sh"
else
  # Stale install without hosted session support — local agent runtime still works.
  labwired_cloud_hosted_ready() { return 1; }
  labwired_cloud_session_load() { return 1; }
  labwired_cloud_export_runtime() { return 1; }
  labwired_cloud_session_save() { fail "upgrade kit: missing lib/cloud-session.sh (re-run install)"; }
  labwired_cloud_session_clear() { :; }
  labwired_cloud_api_base() { echo "${LABWIRED_API_URL:-https://api.labwired.com}"; }
fi

# LabWired brand colors (cyan accent in terminal)
say() { printf '\033[36m==>\033[0m %s\n' "$1"; }
brand() { printf '\033[34m%s\033[0m\n' "$1"; }
fail() { printf 'labwired: %s\n' "$1" >&2; exit 1; }

# User-visible agent config dir: ~/.config/labwired-agent (not ~/.config/opencode).
# Engine still requires OPENCODE_CONFIG_DIR; we always export the LabWired path.
labwired_agent_config_dir() {
  if [[ -n "${LABWIRED_AGENT_CONFIG_DIR:-}" ]]; then
    printf '%s\n' "$LABWIRED_AGENT_CONFIG_DIR"
    return 0
  fi
  if [[ -n "${OPENCODE_CONFIG_DIR:-}" ]]; then
    case "$OPENCODE_CONFIG_DIR" in
      */.config/opencode|*/.config/opencode/)
        ;; # legacy default — fall through to product path
      *)
        # Explicit override (tests, custom installs).
        printf '%s\n' "$OPENCODE_CONFIG_DIR"
        return 0
        ;;
    esac
  fi
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/labwired-agent"
}

# One-time migrate legacy ~/.config/opencode → ~/.config/labwired-agent.
labwired_migrate_agent_config_dir() {
  local new_dir old_dir
  new_dir="$(labwired_agent_config_dir)"
  old_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
  mkdir -p "$new_dir"
  if [[ ! -f "$new_dir/opencode.json" && -f "$old_dir/opencode.json" ]]; then
    say "migrating agent config → $new_dir"
    if command -v rsync >/dev/null 2>&1; then
      rsync -a "$old_dir/" "$new_dir/" 2>/dev/null || cp -a "$old_dir/." "$new_dir/" 2>/dev/null || true
    else
      cp -a "$old_dir/." "$new_dir/" 2>/dev/null || true
    fi
  fi
  export LABWIRED_AGENT_CONFIG_DIR="$new_dir"
  export OPENCODE_CONFIG_DIR="$new_dir"
}

labwired_migrate_agent_config_dir

# Resolve simulator if present; export LABWIRED_CLI only when found.
# Returns 0 if sim resolved, 1 otherwise.
labwired_export_sim() {
  local sim=""
  if sim="$(labwired_resolve_sim "$0")"; then
    export LABWIRED_CLI="$sim"
    return 0
  fi
  unset LABWIRED_CLI
  return 1
}

parse_opencode_version() {
  # shellcheck disable=SC2001
  echo "$1" | sed -n 's/.*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -1
}

cmd_version() {
  local agent_ver="0.1.0"
  if [[ -f "$ROOT/VERSION" ]]; then
    agent_ver="$(tr -d '[:space:]' <"$ROOT/VERSION")"
  fi
  if [[ -f "$ROOT/branding/banner.txt" ]]; then
    cat "$ROOT/branding/banner.txt"
  fi
  echo "LabWired Agent"
  echo "version  ${agent_ver}"
  echo "home     ${ROOT}"
  echo "runtime  pin ${OPENCODE_PIN}"
  if command -v opencode >/dev/null 2>&1; then
    local raw ver
    raw="$(opencode --version 2>&1 || true)"
    ver="$(parse_opencode_version "$raw")"
    echo "runtime  ${ver:-$raw}"
  else
    echo "runtime  (missing — re-run install)"
  fi
}

cmd_doctor() {
  local ok=0
  # Session file alone is not enough — probe model gateway + MCP before claiming signed-in.
  if labwired_cloud_session_load 2>/dev/null || [[ -n "${LABWIRED_ACCESS_TOKEN:-}" ]]; then
    if labwired_cloud_probe_hosted 2>/dev/null; then
      say "ok  cloud-session: signed in (${LABWIRED_EMAIL:-token present})"
      if [[ -n "${LABWIRED_PROJECT:-}" ]]; then
        say "ok  project: $LABWIRED_PROJECT"
      else
        printf '\033[33mwarn\033[0m project: unset — model gateway needs LABWIRED_PROJECT\n'
      fi
      say "ok  hosted-tools: model gateway + MCP authenticated"
    else
      printf '\033[31mFAIL\033[0m cloud-session: token present but API rejects it — run: labwired agent login\n'
      printf '\033[31mFAIL\033[0m hosted-tools: not authenticated (re-login required for hosted model/MCP)\n'
      ok=1
    fi
  else
    say "ok  cloud-session: not signed in (local tools only — labwired agent login for hosted)"
  fi
  local raw ver sim
  local strict="${LABWIRED_DOCTOR_STRICT:-0}"
  # labwired agent doctor --strict  → sim required
  if [[ "${1:-}" == "--strict" ]]; then strict=1; shift || true; fi

  if [[ -f "$ROOT/branding/banner.txt" ]]; then
    cat "$ROOT/branding/banner.txt"
  else
    echo "LabWired Agent"
  fi
  say "home $ROOT"
  if declare -F labwired_prefix_runtime_label >/dev/null 2>&1; then
    say "runtime $(labwired_prefix_runtime_label)"
  fi
  if declare -F labwired_prefix_is_wsl >/dev/null 2>&1 && labwired_prefix_is_wsl; then
    say "ok  wsl: detected (use Linux install path; USB probes need usbipd attach)"
  fi

  if command -v opencode >/dev/null 2>&1; then
    say "ok  agent-runtime: present"
    raw="$(opencode --version 2>&1 || true)"
    ver="$(parse_opencode_version "$raw")"
    if [[ "$ver" == "$OPENCODE_PIN" ]]; then
      say "ok  agent-runtime-pin: $ver matches $OPENCODE_PIN"
    else
      # Accept nearby 1.18.x for product UX; pin is preferred
      if [[ "$ver" == 1.18.* ]]; then
        printf '\033[33mwarn\033[0m agent-runtime-pin: got %s (preferred %s) — OK for product use\n' "${ver:-$raw}" "$OPENCODE_PIN"
      else
        printf '\033[31mFAIL\033[0m agent-runtime-pin: got %s, need %s.x\n' "${ver:-$raw}" "1.18"
        ok=1
      fi
    fi
  else
    printf '\033[31mFAIL\033[0m agent-runtime: not on PATH — re-run install (curl -fsSL https://labwired.com/install | bash)\n'
    ok=1
  fi

  if sim="$(labwired_resolve_sim "$0")"; then
    export LABWIRED_CLI="$sim"
    say "ok  labwired-sim: $sim"
  else
    unset LABWIRED_CLI
    if [[ "$strict" == "1" ]]; then
      printf '\033[31mFAIL\033[0m labwired-sim: no simulator found (strict mode)\n'
      printf '     install: curl -fsSL https://labwired.com/install.sh | sh\n'
      ok=1
    else
      # Sim is optional — debugger / hosted twin / probe are valid paths.
      printf '\033[33mwarn\033[0m labwired-sim: not found (optional — not required)\n'
      printf '     twin: labwired agent login; Core tools are managed by `labwired core`\n'
      printf '     or use LabWired VS Code debugger / probe-rs (sim not forced)\n'
    fi
  fi

  if command -v npx >/dev/null 2>&1; then
    say "ok  npx: present (MCP uses @labwired/mcp)"
  else
    printf '\033[31mFAIL\033[0m npx: not found (Node/npm required for @labwired/mcp)\n'
    ok=1
  fi

  local cfg="${OPENCODE_CONFIG_DIR:-${LABWIRED_AGENT_CONFIG_DIR:-$HOME/.config/labwired-agent}}"
  if [[ -f "$cfg/opencode.json" ]]; then
    say "ok  agent-config: present"
    if grep -q 'LabWired Agent' "$cfg/opencode.json" 2>/dev/null \
      || grep -q '"labwired"' "$cfg/opencode.json" 2>/dev/null; then
      say "ok  brand: LabWired Agent"
    else
      printf '\033[33mwarn\033[0m brand: re-run install to apply LabWired Agent config\n'
    fi
  else
    printf '\033[31mFAIL\033[0m agent-config: missing — re-run install\n'
    ok=1
  fi

  if [[ -d "$cfg/branding" ]] || [[ -d "$ROOT/branding" ]]; then
    say "ok  branding: assets present"
  else
    printf '\033[33mwarn\033[0m branding: missing — re-run ./install.sh\n'
  fi
  if [[ -f "$cfg/themes/labwired.json" ]] || [[ -f "$ROOT/branding/themes/labwired.json" ]]; then
    say "ok  theme: labwired"
  else
    printf '\033[33mwarn\033[0m theme: missing labwired — re-run labwired agent or ./install.sh\n'
  fi
  if [[ -f "$cfg/tui.json" ]] && grep -q '"labwired"' "$cfg/tui.json" 2>/dev/null; then
    say "ok  tui: LabWired theme selected"
  elif [[ -f "$ROOT/config/tui.json" ]]; then
    say "ok  tui: kit default (will apply on next agent start)"
  else
    printf '\033[33mwarn\033[0m tui: missing — re-run ./install.sh\n'
  fi
  if [[ -f "$cfg/plugins/labwired-brand.tsx" ]] || [[ -f "$ROOT/plugins/labwired-brand.tsx" ]]; then
    say "ok  brand-plugin: labwired.brand (LabWired Agent home logo)"
  else
    printf '\033[33mwarn\033[0m brand-plugin: missing — re-run labwired agent or install\n'
  fi

  # Primary packs (ship surface). Aliases optional.
  local skill
  for skill in develop golden-path bringup prove observe desk-hw import-circuit; do
    if [[ -f "$cfg/skills/$skill/SKILL.md" ]]; then
      say "ok  skill: $skill"
    elif [[ -f "$ROOT/skills/$skill/SKILL.md" ]]; then
      say "ok  skill: $skill (kit)"
    else
      printf '\033[31mFAIL\033[0m skill: missing pack %s — run labwired agent (prepare) or ./install.sh\n' "$skill"
      ok=1
    fi
  done

  # Multi-probe backend (probe-rs) + virtual LabWired device
  local prs=""
  if prs="$(labwired_resolve_probe_rs 2>/dev/null)"; then
    say "ok  probe-backend: $prs (ST-Link / J-Link / CMSIS-DAP / …)"
  else
    if [[ "$strict" == "1" ]]; then
      printf '\033[31mFAIL\033[0m probe-backend: probe-rs not installed\n'
      ok=1
    else
      printf '\033[33mwarn\033[0m probe-backend: probe-rs not installed\n'
    fi
    printf '     fix: ./install.sh --full   # or: labwired agent probe install-backend\n'
  fi
  if sim="$(labwired_resolve_sim "$0" 2>/dev/null)"; then
    say "ok  virtual-device: LabWired sim ($sim)"
  else
    if [[ "$strict" == "1" ]]; then
      printf '\033[31mFAIL\033[0m virtual-device: sim missing\n'
      ok=1
    else
      printf '\033[33mwarn\033[0m virtual-device: sim missing (virtual boards)\n'
    fi
    printf '     fix: ./install.sh --full   # installs labwired-sim\n'
  fi
  if command -v pio >/dev/null 2>&1 || command -v platformio >/dev/null 2>&1; then
    say "ok  platformio: $(command -v pio 2>/dev/null || command -v platformio)"
  else
    printf '\033[33mwarn\033[0m platformio: not found (optional for Arduino/ESP flash)\n'
  fi

  if [[ $ok -eq 0 ]]; then
    say "ready"
    return 0
  fi
  printf '\nnot ready — fix FAILs above (./install.sh --full)\n'
  return 1
}


# ── Hosted path: shared MCP tools + model gateway ───────────────────────────

cmd_login() {
  local api code_json device_code user_code uri interval expires_in
  local poll_status access refresh expires project email path
  local status err_msg
  api="$(labwired_cloud_api_base)"
  say "starting device sign-in against $api"
  if ! command -v python3 >/dev/null 2>&1; then
    fail "python3 required for labwired agent login"
  fi
  code_json="$(
    python3 - <<PY
import json, urllib.request
req = urllib.request.Request(
    "$api/v1/auth/device/code",
    data=b"{}",
    headers={
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": "labwired-agent/0.3.9",
    },
    method="POST",
)
with urllib.request.urlopen(req, timeout=30) as r:
    print(r.read().decode())
PY
  )" || fail "device/code request failed — is $api reachable?"
  eval "$(
    CODE_JSON="$code_json" python3 - <<'PY'
import json, os
d = json.loads(os.environ["CODE_JSON"])
def sh(s):
    return "'" + str(s).replace("'", "'\"'\"'") + "'"
print(f"device_code={sh(d['deviceCode'])}")
print(f"user_code={sh(d['userCode'])}")
print(f"uri={sh(d.get('verificationUriComplete') or d.get('verificationUri') or '')}")
print(f"interval={int(d.get('interval') or 2)}")
print(f"expires_in={int(d.get('expiresIn') or 900)}")
PY
  )"
  brand ""
  brand "  Open:  $uri"
  brand "  Code:  $user_code"
  brand ""
  say "waiting for approval (poll every ${interval}s)…"
  if command -v open >/dev/null 2>&1 && [[ -n "$uri" ]]; then
    open "$uri" 2>/dev/null || true
  fi
  local deadline now
  now="$(date +%s)"
  deadline=$((now + expires_in))
  while true; do
    now="$(date +%s)"
    if (( now > deadline )); then
      fail "device code expired — run labwired agent login again"
    fi
    poll_status="$(
      DEVICE_CODE="$device_code" API="$api" python3 - <<'PY'
import json, os, urllib.request, urllib.error
api = os.environ["API"]
body = json.dumps({
    "deviceCode": os.environ["DEVICE_CODE"],
    "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
}).encode()
req = urllib.request.Request(
    f"{api}/v1/auth/device/token",
    data=body,
    headers={
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": "labwired-agent/0.3.9",
    },
    method="POST",
)
try:
    with urllib.request.urlopen(req, timeout=30) as r:
        print(r.read().decode())
except urllib.error.HTTPError as e:
    print(e.read().decode())
PY
    )"
    eval "$(
      POLL_JSON="$poll_status" python3 - <<'PY'
import json, os, sys
raw = os.environ["POLL_JSON"]
try:
    d = json.loads(raw)
except Exception:
    print("status=error")
    sys.exit(0)
def sh(s):
    return "'" + str(s).replace("'", "'\"'\"'") + "'"
err = d.get("error")
if err == "authorization_pending" or (isinstance(err, dict) and err.get("code") == "authorization_pending"):
    print("status=pending")
elif err in ("expired_token", "access_denied") or (isinstance(err, dict) and err.get("code") in ("expired_token", "access_denied")):
    code = err if isinstance(err, str) else err.get("code")
    print(f"status={code}")
elif d.get("access_token"):
    print("status=approved")
    print(f"access={sh(d['access_token'])}")
    print(f"refresh={sh(d.get('refresh_token') or '')}")
    print(f"expires={int(d.get('expires_in') or 3600)}")
    print(f"email={sh(d.get('email') or '')}")
else:
    print("status=error")
    msg = d.get("error_description") or d.get("error") or raw[:200]
    print(f"err_msg={sh(msg)}")
PY
    )"
    case "${status:-}" in
      pending)
        sleep "$interval"
        continue
        ;;
      approved)
        break
        ;;
      expired|expired_token)
        fail "device code expired — run labwired agent login again"
        ;;
      denied|access_denied)
        fail "sign-in denied in browser"
        ;;
      *)
        fail "token poll failed: ${err_msg:-unknown}"
        ;;
    esac
  done

  project="$(
    ACCESS="$access" API="$api" python3 - <<'PY'
import json, os, urllib.request, urllib.error
api = os.environ["API"]
token = os.environ["ACCESS"]
h = {"Authorization": f"Bearer {token}", "Accept": "application/json", "User-Agent": "labwired-agent/0.3.9"}

def get(path):
    req = urllib.request.Request(f"{api}{path}", headers=h)
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode())

def post(path, body):
    req = urllib.request.Request(
        f"{api}{path}",
        data=json.dumps(body).encode(),
        headers={**h, "Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode())

try:
    data = get("/v1/projects")
    projects = data.get("projects") or data.get("items") or []
    if projects:
        p0 = projects[0]
        print(p0.get("id") or p0.get("project_id") or "")
        raise SystemExit(0)
except Exception:
    pass
try:
    created = post("/v1/projects", {"name": "Desktop"})
    p = created.get("project") or created
    print(p.get("id") or p.get("project_id") or "")
except Exception:
    print("", end="")
PY
  )"

  path="$(labwired_cloud_session_save "$access" "$refresh" "$expires" "$project" "$email")"
  say "signed in${email:+ as $email}"
  if [[ -n "$project" ]]; then
    say "project: $project"
  else
    echo "labwired: warning — no project id yet; set LABWIRED_PROJECT before chatting" >&2
  fi
  say "session: $path"
  export LABWIRED_ACCESS_TOKEN="$access"
  export LABWIRED_PROJECT="${project:-}"
  labwired_install_hosted_opencode_config || true
  say "LabWired Agent ready — start with: labwired agent"
}

# First start / expired session: sign in with a LabWired account.
# Product auth is account login only — no engine connect.
labwired_ensure_account() {
  # Explicit local / BYO model (user set URL that is not LabWired cloud).
  if [[ -n "${LABWIRED_MODEL_URL:-}" \
    && "${LABWIRED_MODEL_URL}" != *api.labwired.com* \
    && -n "${LABWIRED_MODEL_KEY:-}" \
    && "${LABWIRED_MODEL_KEY}" != "local" ]]; then
    return 0
  fi
  if [[ "${LABWIRED_SKIP_LOGIN:-0}" == "1" ]]; then
    return 0
  fi
  # Live session or desktop lwd_ token — OK.
  if labwired_cloud_hosted_ready; then
    return 0
  fi
  brand ""
  brand "  LabWired Agent"
  brand "  Sign in with your LabWired account (session missing or expired)."
  brand ""
  say "LabWired account login required"
  cmd_login || fail "sign-in required — run: labwired agent login"
  labwired_cloud_session_load || fail "sign-in incomplete — run: labwired agent login"
}

labwired_install_hosted_opencode_config() {
  local cfg_dir src
  cfg_dir="${OPENCODE_CONFIG_DIR:-${LABWIRED_AGENT_CONFIG_DIR:-$HOME/.config/labwired-agent}}"
  src="$ROOT/config/opencode.hosted.json"
  if [[ ! -f "$src" ]]; then
    return 1
  fi
  mkdir -p "$cfg_dir/skills"
  cp "$src" "$cfg_dir/opencode.json"
  if [[ -f "$ROOT/config/AGENTS.md" ]]; then
    cp "$ROOT/config/AGENTS.md" "$cfg_dir/AGENTS.md"
  fi
  if [[ -d "$ROOT/skills" ]]; then
    local _legacy
    for _legacy in verify-firmware part-knowledge board-bringup scaffold-firmware \
      diagnose-firmware firmware-repair-loop report-evidence inspect-evidence \
      compose-observability flash-firmware hw-promote; do
      rm -rf "$cfg_dir/skills/$_legacy"
    done
    cp -R "$ROOT/skills/." "$cfg_dir/skills/"
  fi
  say "LabWired Agent config: hosted (api.labwired.com) → $cfg_dir"
}

cmd_logout() {
  if [[ -z "${LABWIRED_ACCESS_TOKEN:-}" ]]; then
    labwired_cloud_session_load 2>/dev/null || true
  fi
  if [[ -n "${LABWIRED_ACCESS_TOKEN:-}" ]]; then
    API="$(labwired_cloud_api_base)" ACCESS="${LABWIRED_ACCESS_TOKEN}" REFRESH="${LABWIRED_REFRESH_TOKEN:-}" python3 - <<'PY' 2>/dev/null || true
import json, os, urllib.request
api = os.environ["API"]
token = os.environ["ACCESS"]
body = {}
if os.environ.get("REFRESH"):
    body["refresh_token"] = os.environ["REFRESH"]
req = urllib.request.Request(
    f"{api}/v1/auth/revoke",
    data=json.dumps(body).encode(),
    headers={
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "Accept": "application/json",
    },
    method="POST",
)
try:
    urllib.request.urlopen(req, timeout=15)
except Exception:
    pass
PY
  fi
  labwired_cloud_session_clear
  say "signed out (LabWired Agent session cleared)"
}

# Product auth entrypoints — never fall through to engine /connect (third-party model marketplaces).
cmd_auth() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    login|connect|"" )
      cmd_login "$@"
      ;;
    logout)
      cmd_logout "$@"
      ;;
    list|ls|status|whoami)
      cmd_whoami "$@"
      ;;
    help|--help|-h)
      cat <<'AEOF'
LabWired Agent auth

  labwired agent login     Sign in with your LabWired account (device code)
  labwired agent logout    Clear LabWired session
  labwired agent whoami    Show signed-in account / project
  labwired agent auth      Alias for login

First start runs login automatically. Hosted model + MCP use that
LabWired session (api.labwired.com).
AEOF
      ;;
    *)
      fail "unknown auth command '$sub' — try: labwired agent login | logout | whoami"
      ;;
  esac
}

cmd_whoami() {
  # Prefer a loadable hosted session over ambient env pollution.
  if ! labwired_cloud_session_load; then
    if [[ -n "${LABWIRED_ACCESS_TOKEN:-}" ]]; then
      : # token injected by desktop / env
    elif labwired_cloud_desktop_token >/dev/null 2>&1; then
      export LABWIRED_ACCESS_TOKEN
      LABWIRED_ACCESS_TOKEN="$(labwired_cloud_desktop_token)"
      export LABWIRED_MODEL_KEY="${LABWIRED_ACCESS_TOKEN}"
    else
      echo "not signed in — run: labwired agent login"
      return 1
    fi
  fi
  if [[ -z "${LABWIRED_ACCESS_TOKEN:-}" ]]; then
    echo "not signed in — run: labwired agent login"
    return 1
  fi
  echo "api:      $(labwired_cloud_api_base)"
  echo "email:    ${LABWIRED_EMAIL:-(unknown)}"
  echo "project:  ${LABWIRED_PROJECT:-(none — set LABWIRED_PROJECT)}"
  echo "token:    ${LABWIRED_ACCESS_TOKEN:0:8}…"
  echo "model:    ${LABWIRED_MODEL_URL:-https://api.labwired.com/v1}/  model=${LABWIRED_MODEL:-labwired-default}"
  echo "mcp:      remote https://api.labwired.com/mcp (shared labwired_* tools)"
}

# Product chrome: LabWired theme, banner, terminal title, and home_logo plugin
# that replaces the stock engine home logo. Runtime stays under the hood.
labwired_apply_branding() {
  local cfg_dir
  cfg_dir="${OPENCODE_CONFIG_DIR:-${LABWIRED_AGENT_CONFIG_DIR:-$HOME/.config/labwired-agent}}"
  mkdir -p "$cfg_dir/themes" "$cfg_dir/branding" "$cfg_dir/plugins"

  # Product theme is always refreshed; user banner assets stay if already present.
  if [[ -f "$ROOT/branding/themes/labwired.json" ]]; then
    cp "$ROOT/branding/themes/labwired.json" "$cfg_dir/themes/labwired.json"
  fi
  if [[ -d "$ROOT/branding" ]]; then
    local f
    for f in "$ROOT/branding"/*; do
      [[ -f "$f" ]] || continue
      local dest="$cfg_dir/branding/$(basename "$f")"
      if [[ ! -e "$dest" ]]; then
        cp "$f" "$dest"
      fi
    done
  fi

  # Always ship the brand plugin next to tui.json (path is relative to that file).
  if [[ -f "$ROOT/plugins/labwired-brand.tsx" ]]; then
    cp "$ROOT/plugins/labwired-brand.tsx" "$cfg_dir/plugins/labwired-brand.tsx"
  fi

  # Ensure tui.json selects LabWired theme + brand plugin. Preserve other user
  # keys (keybinds, attention, …) when a tui.json already exists.
  if [[ -f "$cfg_dir/tui.json" ]]; then
    python3 - "$cfg_dir/tui.json" <<'PY' 2>/dev/null || true
import json, sys
path = sys.argv[1]
try:
    cfg = json.load(open(path))
except Exception:
    cfg = {}
if not isinstance(cfg, dict):
    cfg = {}
theme = cfg.get("theme")
if theme in (None, "", "system", "opencode"):
    cfg["theme"] = "labwired"
plugins = cfg.get("plugin")
if not isinstance(plugins, list):
    plugins = []
# Normalize plugin specs to strings for membership checks.
def _spec(p):
    if isinstance(p, str):
        return p
    if isinstance(p, list) and p:
        return str(p[0])
    return ""
wanted = "./plugins/labwired-brand.tsx"
if not any(_spec(p) == wanted or _spec(p).endswith("labwired-brand.tsx") for p in plugins):
    plugins = [wanted] + plugins
cfg["plugin"] = plugins
cfg.setdefault("$schema", "https://opencode.ai/tui.json")
open(path, "w").write(json.dumps(cfg, indent=2) + "\n")
PY
  elif [[ -f "$ROOT/config/tui.json" ]]; then
    cp "$ROOT/config/tui.json" "$cfg_dir/tui.json"
  else
    cat >"$cfg_dir/tui.json" <<'JSON'
{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "labwired",
  "plugin": ["./plugins/labwired-brand.tsx"]
}
JSON
  fi

  # Product identity: do not let the engine rename the terminal tab to "OpenCode".
  # OpenCode only accepts "1" or "true" (case-insensitive).
  export OPENCODE_DISABLE_TERMINAL_TITLE=1

  labwired_set_window_title "LabWired Agent"
}

# Set terminal window + tab title (OSC 0 and OSC 2). Safe no-op off TTY.
labwired_set_window_title() {
  local title="${1:-LabWired Agent}"
  if [[ -t 1 ]] || [[ -t 2 ]]; then
    # OSC 0 = icon+title, OSC 2 = window title (xterm / Terminal / iTerm / VS Code)
    printf '\033]0;%s\007' "$title" 2>/dev/null || true
    printf '\033]2;%s\007' "$title" 2>/dev/null || true
  fi
}

# Always brand the process before handing off to the engine binary.
# argv0 "labwired-agent" is what some terminals show when they ignore OSC titles.
labwired_exec_opencode() {
  export OPENCODE_DISABLE_TERMINAL_TITLE=1
  labwired_set_window_title "LabWired Agent"
  local bin
  bin="$(command -v opencode 2>/dev/null || true)"
  if [[ -z "$bin" ]]; then
    fail "LabWired Agent runtime not found. Re-run: curl -fsSL https://labwired.com/install | bash"
  fi
  # argv0 rename: process list / some terminal tabs say labwired-agent, not opencode.
  # OPENCODE_DISABLE_TERMINAL_TITLE stops the engine from overwriting to "OpenCode".
  exec -a labwired-agent "$bin" "$@"
}

labwired_splash() {
  if [[ ! -t 2 ]]; then
    return 0
  fi
  if [[ -f "$ROOT/branding/banner.txt" ]]; then
    printf '\033[34m' >&2
    cat "$ROOT/branding/banner.txt" >&2
    printf '\033[0m' >&2
  else
    brand "  LabWired Agent"
    brand "  The easy way to build hardware"
  fi
}

labwired_prepare_agent_start() {
  # Ensure skills + AGENTS.md are discoverable by the agent runtime even when the user
  # only has a partial ~/.config/labwired-agent from an older install.
  local cfg_dir
  cfg_dir="${OPENCODE_CONFIG_DIR:-${LABWIRED_AGENT_CONFIG_DIR:-$HOME/.config/labwired-agent}}"
  mkdir -p "$cfg_dir/skills"
  labwired_apply_branding
  if [[ -f "$ROOT/config/AGENTS.md" && ! -f "$cfg_dir/AGENTS.md" ]]; then
    cp "$ROOT/config/AGENTS.md" "$cfg_dir/AGENTS.md"
  fi
  if [[ -d "$ROOT/skills" ]]; then
    # Drop legacy micro-skill names, then refresh packs + Superpowers
    local _legacy
    for _legacy in verify-firmware part-knowledge board-bringup scaffold-firmware \
      diagnose-firmware firmware-repair-loop report-evidence inspect-evidence \
      compose-observability flash-firmware hw-promote; do
      rm -rf "$cfg_dir/skills/$_legacy"
    done
    cp -R "$ROOT/skills/." "$cfg_dir/skills/" 2>/dev/null || true
  fi

  if labwired_cloud_hosted_ready; then
    labwired_cloud_export_runtime || fail "hosted session incomplete — run: labwired agent login"
    # Agent runtime substitutes {env:VAR} from the process environment
    export LABWIRED_ACCESS_TOKEN LABWIRED_PROJECT LABWIRED_MODEL_URL LABWIRED_MODEL_KEY LABWIRED_MODEL LABWIRED_API_URL
    if [[ -z "${LABWIRED_PROJECT:-}" ]]; then
      echo "labwired: warning — LABWIRED_PROJECT empty; model gateway will reject chat" >&2
      echo "         fix: labwired agent login  (or export LABWIRED_PROJECT=<id>)" >&2
    fi
    # Always re-apply hosted agent config so MCP is remote labwired_* tools
    if [[ -f "$ROOT/config/opencode.hosted.json" ]]; then
      labwired_install_hosted_opencode_config || true
    fi
    export LABWIRED_PROFILE=hosted
    export OPENCODE_CONFIG_DIR="$cfg_dir"
    # Session token is exported as env for hosted agent config {env:LABWIRED_ACCESS_TOKEN}.
    # No engine auth.json seeding — LabWired account login is the product credential.
    say "mode: LabWired Agent (hosted · api.labwired.com)"
    say "model: ${LABWIRED_MODEL_URL:-}/  id=${LABWIRED_MODEL:-labwired-default}"
  else
    labwired_export_sim || true
    # Local default config if none
    if [[ ! -f "$cfg_dir/opencode.json" && -f "$ROOT/config/opencode.json" ]]; then
      cp "$ROOT/config/opencode.json" "$cfg_dir/opencode.json"
      say "wrote LabWired Agent config → $cfg_dir"
    fi
    export OPENCODE_CONFIG_DIR="$cfg_dir"
    say "mode: LabWired Agent (local tools · npx @labwired/mcp or LABWIRED_CLI)"
  fi
}

cmd_compose() {
  # Agent-callable observe surface (elements → JSON). Not a ready-made plot product.
  local sub="${1:-}"
  shift || true
  case "$sub" in
    job|show)
      # One path: user need → recipe → compose (ties up D5 without Open Plot).
      # usage: compose job --ask "plot LED vs UART" --uart log|--from last-run [--out f]
      exec python3 "$ROOT/scripts/compose-job.py" "$@"
      ;;
    uart)
      local file="" out=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --file|-f) file="${2:-}"; shift 2 || true ;;
          --out|-o) out="${2:-}"; shift 2 || true ;;
          *)
            if [[ -z "$file" && -f "$1" ]]; then file="$1"; shift; else shift || true; fi
            ;;
        esac
      done
      [[ -n "$file" ]] || fail "usage: labwired agent compose uart --file <uart.log> [--out composed.json]"
      if [[ -n "$out" ]]; then
        exec python3 "$ROOT/scripts/compose-elements.py" --uart "$file" --out "$out"
      else
        exec python3 "$ROOT/scripts/compose-elements.py" --uart "$file"
      fi
      ;;
    capture)
      local cap="" edges="" uart="" out=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --capture|-c) cap="${2:-}"; shift 2 || true ;;
          --edges) edges="${2:-}"; shift 2 || true ;;
          --uart) uart="${2:-}"; shift 2 || true ;;
          --out|-o) out="${2:-}"; shift 2 || true ;;
          *) shift || true ;;
        esac
      done
      [[ -n "$cap" || -n "$edges" ]] || fail "usage: labwired agent compose capture --capture <json> [--uart log] [--out out.json]"
      local args=()
      [[ -n "$cap" ]] && args+=(--capture "$cap")
      [[ -n "$edges" ]] && args+=(--edges-csv "$edges")
      [[ -n "$uart" ]] && args+=(--uart "$uart")
      [[ -n "$out" ]] && args+=(--out "$out")
      exec python3 "$ROOT/scripts/compose-from-capture.py" "${args[@]}"
      ;;
    help|--help|-h|"")
      cat <<'CEOF'
labwired agent compose — tools for the agent to build views from real data
  (not a ready-made plot product; agent decides when to call these)

  labwired agent compose job --ask "plot LED vs UART" --uart <log> [--out composed.json]
  labwired agent compose job --ask "…" --from last-run [--out composed.json]
  labwired agent compose job --ask "show logic capture" --capture <json> [--out composed.json]
  labwired agent compose uart --file <uart.log> [--out composed.json]
  labwired agent compose capture --capture <json> [--uart log] [--out out.json]

Never invent waveforms. Observation only — not model_verified / hardware_observed.
CEOF
      ;;
    *)
      fail "unknown compose subcommand: $sub (try: job | uart | capture | help)"
      ;;
  esac
}

