#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/dispatch.sh
source "$ROOT/lib/dispatch.sh"

labwired_product_help() {
  cat <<'EOF'
LabWired — firmware development tools

  labwired agent [command]   Start or manage LabWired Agent
  labwired core <command>    Run LabWired Core tools
  labwired editor            Open LabWired Editor

Run `labwired agent --help` or `labwired core --help` for component help.
EOF
}

case "${1:-}" in
  ""|help|--help|-h)
    labwired_product_help
    ;;
  agent)
    shift
    labwired_dispatch_exec_agent "$@"
    ;;
  core)
    shift
    labwired_dispatch_exec_core "$@"
    ;;
  editor)
    printf 'LabWired Editor is not installed.\n' >&2
    printf 'Install LabWired Editor, then run: labwired editor\n' >&2
    exit 1
    ;;
  *)
    if labwired_dispatch_is_legacy_core_command "$1"; then
      labwired_dispatch_exec_core "$@"
    fi
    printf 'labwired: unknown command: %s\n' "$1" >&2
    printf 'Run: labwired --help\n' >&2
    exit 2
    ;;
esac
