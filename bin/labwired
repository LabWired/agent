#!/usr/bin/env bash
# LabWired Agent — write firmware, run on a virtual board.
set -euo pipefail

export LABWIRED_MODEL_URL="${LABWIRED_MODEL_URL:-http://127.0.0.1:11434/v1}"
export LABWIRED_MODEL_KEY="${LABWIRED_MODEL_KEY:-local}"
export LABWIRED_BUILDER_URL="${LABWIRED_BUILDER_URL:-}"
# Simulator / oracle CLI the MCP shells out to (NOT this launcher).
# Resolved only when a real binary exists — never invent "labwired-cli".

# Pinned OpenCode version (npm package opencode-ai). Bump deliberately.
OPENCODE_PIN="${OPENCODE_PIN:-1.18.7}"

# Product home resolution (branded LabWired install)
# 1) LABWIRED_AGENT_HOME  2) sibling of this bin/  3) ~/.labwired/agent
_labwired_find_root() {
  local cand
  if [[ -n "${LABWIRED_AGENT_HOME:-}" && -f "${LABWIRED_AGENT_HOME}/lib/resolve-sim.sh" ]]; then
    echo "${LABWIRED_AGENT_HOME}"
    return 0
  fi
  cand="$(cd "$(dirname "$0")/.." && pwd)"
  if [[ -f "$cand/lib/resolve-sim.sh" ]]; then
    echo "$cand"
    return 0
  fi
  cand="${HOME}/.labwired/agent"
  if [[ -f "$cand/lib/resolve-sim.sh" ]]; then
    echo "$cand"
    return 0
  fi
  # last resort: directory containing this script
  echo "$(cd "$(dirname "$0")" && pwd)"
}

ROOT="$(_labwired_find_root)"
export LABWIRED_AGENT_HOME="$ROOT"
# shellcheck source=lib/resolve-sim.sh
source "$ROOT/lib/resolve-sim.sh"

# LabWired brand colors (cyan accent in terminal)
say() { printf '\033[36m==>\033[0m %s\n' "$1"; }
brand() { printf '\033[34m%s\033[0m\n' "$1"; }
fail() { printf 'labwired: %s\n' "$1" >&2; exit 1; }

# Resolve simulator if present; export LABWIRED_CLI only when found.
# Returns 0 if sim resolved, 1 otherwise.
labwired_export_sim() {
  local sim=""
  if sim="$(labwired_resolve_sim "$0")"; then
    export LABWIRED_CLI="$sim"
    return 0
  fi
  unset LABWIRED_CLI
  return 1
}

parse_opencode_version() {
  # shellcheck disable=SC2001
  echo "$1" | sed -n 's/.*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -1
}

cmd_version() {
  local agent_ver="0.1.0"
  if [[ -f "$ROOT/VERSION" ]]; then
    agent_ver="$(tr -d '[:space:]' <"$ROOT/VERSION")"
  fi
  if [[ -f "$ROOT/branding/banner.txt" ]]; then
    cat "$ROOT/branding/banner.txt"
  fi
  echo "LabWired Agent"
  echo "version  ${agent_ver}"
  echo "home     ${ROOT}"
  echo "pin      opencode-ai@${OPENCODE_PIN}"
  if command -v opencode >/dev/null 2>&1; then
    local raw ver
    raw="$(opencode --version 2>&1 || true)"
    ver="$(parse_opencode_version "$raw")"
    echo "opencode ${ver:-$raw}"
  else
    echo "opencode (missing — run install.sh)"
  fi
}

cmd_doctor() {
  local ok=0
  local raw ver sim
  local strict="${LABWIRED_DOCTOR_STRICT:-0}"
  # labwired doctor --strict  → sim required
  if [[ "${1:-}" == "--strict" ]]; then strict=1; shift || true; fi

  if [[ -f "$ROOT/branding/banner.txt" ]]; then
    cat "$ROOT/branding/banner.txt"
  else
    echo "LabWired Agent"
  fi
  say "home $ROOT"

  if command -v opencode >/dev/null 2>&1; then
    say "ok  opencode-binary: $(command -v opencode)"
    raw="$(opencode --version 2>&1 || true)"
    ver="$(parse_opencode_version "$raw")"
    if [[ "$ver" == "$OPENCODE_PIN" ]]; then
      say "ok  opencode-pin: $ver matches $OPENCODE_PIN"
    else
      # Accept nearby 1.18.x for product UX; pin is preferred
      if [[ "$ver" == 1.18.* ]]; then
        printf '\033[33mwarn\033[0m opencode-pin: got %s (preferred %s) — OK for product use\n' "${ver:-$raw}" "$OPENCODE_PIN"
      else
        printf '\033[31mFAIL\033[0m opencode-pin: got %s, need %s.x\n' "${ver:-$raw}" "1.18"
        ok=1
      fi
    fi
  else
    printf '\033[31mFAIL\033[0m opencode-binary: not on PATH — run ./install.sh (installs opencode-ai@%s)\n' "$OPENCODE_PIN"
    ok=1
  fi

  if sim="$(labwired_resolve_sim "$0")"; then
    export LABWIRED_CLI="$sim"
    say "ok  labwired-sim: $sim"
  else
    unset LABWIRED_CLI
    if [[ "$strict" == "1" ]]; then
      printf '\033[31mFAIL\033[0m labwired-sim: no simulator found (strict mode)\n'
      printf '     install: curl -fsSL https://labwired.com/install.sh | sh\n'
      ok=1
    else
      printf '\033[33mwarn\033[0m labwired-sim: not found (optional for agent shell)\n'
      printf '     full checks: curl -fsSL https://labwired.com/install.sh | sh\n'
      printf '     or: export LABWIRED_CLI=/path/to/simulator\n'
    fi
  fi

  if command -v npx >/dev/null 2>&1; then
    say "ok  npx: present (MCP uses @labwired/mcp)"
  else
    printf '\033[31mFAIL\033[0m npx: not found (Node/npm required for @labwired/mcp)\n'
    ok=1
  fi

  local cfg="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
  if [[ -f "$cfg/opencode.json" ]]; then
    say "ok  config: $cfg/opencode.json"
    if grep -q 'LabWired Agent' "$cfg/opencode.json" 2>/dev/null \
      || grep -q '"labwired"' "$cfg/opencode.json" 2>/dev/null; then
      say "ok  brand: LabWired"
    else
      printf '\033[33mwarn\033[0m brand: re-run ./install.sh\n'
    fi
  else
    printf '\033[31mFAIL\033[0m config: missing %s/opencode.json — run ./install.sh\n' "$cfg"
    ok=1
  fi

  if [[ -d "$cfg/branding" ]] || [[ -d "$ROOT/branding" ]]; then
    say "ok  branding: assets present"
  else
    printf '\033[33mwarn\033[0m branding: missing — re-run ./install.sh\n'
  fi

  local skill
  for skill in \
    verify-firmware diagnose-firmware inspect-evidence \
    board-bringup scaffold-firmware report-evidence
  do
    if [[ -f "$cfg/skills/$skill/SKILL.md" ]]; then
      say "ok  skill: $skill"
    else
      printf '\033[31mFAIL\033[0m skill: missing %s/skills/%s — run ./install.sh\n' "$cfg" "$skill"
      ok=1
    fi
  done

  if [[ $ok -eq 0 ]]; then
    say "ready"
    return 0
  fi
  printf '\nnot ready — fix FAILs above\n'
  return 1
}

cmd_help() {
  if [[ -f "$ROOT/branding/banner.txt" ]]; then
    cat "$ROOT/branding/banner.txt"
    echo
  fi
  cat <<EOF
LabWired Agent

Usage:
  labwired                 Start
  labwired doctor          Check install
  labwired version         Version
  labwired assert-status <expected> [file]
                           Exit 0 if verify JSON status matches
  labwired help            This help

Env:
  LABWIRED_MODEL_URL       Model base URL (default Ollama)
  LABWIRED_MODEL_KEY       API key
  LABWIRED_BUILDER_URL     Compile service
  LABWIRED_CLI / LABWIRED_SIM   Simulator binary
  OPENCODE_PIN             opencode-ai pin (default ${OPENCODE_PIN})
  OPENCODE_CONFIG_DIR      Config dir (default ~/.config/opencode)
EOF
}

cmd_assert_status() {
  local expected="${1:-}"
  local file="${2:-}"
  if [[ -z "$expected" ]]; then
    fail "usage: labwired assert-status <expected> [file]"
  fi
  # shellcheck source=lib/assert-status.sh
  source "$ROOT/lib/assert-status.sh"
  if [[ -n "$file" && "$file" != "-" ]]; then
    labwired_assert_status "$expected" <"$file"
  else
    labwired_assert_status "$expected"
  fi
}

case "${1:-}" in
  doctor)  shift; cmd_doctor "$@" ;;
  version|--version|-V) cmd_version ;;
  help|--help|-h) cmd_help ;;
  assert-status)
    shift
    cmd_assert_status "$@"
    ;;
  "")
    if ! command -v opencode >/dev/null 2>&1; then
      fail "'opencode' not found on PATH. Run ./install.sh first (pins opencode-ai@${OPENCODE_PIN})."
    fi
    if labwired_export_sim; then
      : # LABWIRED_CLI exported for MCP child
    else
      echo "labwired: warning — no simulator found; run/verify will fail." >&2
      echo "         install: curl -fsSL https://labwired.com/install.sh | sh" >&2
      echo "         or set LABWIRED_CLI / LABWIRED_SIM to the simulator binary." >&2
    fi
    # Config/skills live under ~/.config/opencode from install.sh
    exec opencode "$@"
    ;;
  *)
    # Pass through to opencode (e.g. labwired mcp list)
    if ! command -v opencode >/dev/null 2>&1; then
      fail "'opencode' not found on PATH. Run ./install.sh first."
    fi
    labwired_export_sim || true
    exec opencode "$@"
    ;;
esac
