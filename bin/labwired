#!/usr/bin/env bash
# LabWired Firmware Agent — the easiest way to write firmware.
# (LabWired product tagline: the easy way to build hardware.)
# OpenCode shell (no fork): wires opencode to @labwired/mcp, skills, local/on-prem model.
set -euo pipefail

export LABWIRED_MODEL_URL="${LABWIRED_MODEL_URL:-http://127.0.0.1:11434/v1}"
export LABWIRED_MODEL_KEY="${LABWIRED_MODEL_KEY:-local}"
export LABWIRED_BUILDER_URL="${LABWIRED_BUILDER_URL:-}"
# Simulator / oracle CLI the MCP shells out to (NOT this launcher).
# Resolved only when a real binary exists — never invent "labwired-cli".

# Pinned OpenCode version (npm package opencode-ai). Bump deliberately.
OPENCODE_PIN="${OPENCODE_PIN:-1.18.7}"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [[ ! -f "$ROOT/lib/resolve-sim.sh" ]]; then
  # Installed copy: only bin/labwired may be on PATH; libs sit next to it.
  ROOT="$(cd "$(dirname "$0")" && pwd)"
fi
# shellcheck source=lib/resolve-sim.sh
source "$ROOT/lib/resolve-sim.sh"

say() { printf '\033[36m==>\033[0m %s\n' "$1"; }
fail() { printf 'labwired: %s\n' "$1" >&2; exit 1; }

# Resolve simulator if present; export LABWIRED_CLI only when found.
# Returns 0 if sim resolved, 1 otherwise.
labwired_export_sim() {
  local sim=""
  if sim="$(labwired_resolve_sim "$0")"; then
    export LABWIRED_CLI="$sim"
    return 0
  fi
  unset LABWIRED_CLI
  return 1
}

parse_opencode_version() {
  # shellcheck disable=SC2001
  echo "$1" | sed -n 's/.*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -1
}

cmd_version() {
  echo "LabWired Firmware Agent — the easiest way to write firmware"
  echo "agent proposes · oracle disposes"
  echo "opencode pin: ${OPENCODE_PIN}"
  if command -v opencode >/dev/null 2>&1; then
    local raw ver
    raw="$(opencode --version 2>&1 || true)"
    ver="$(parse_opencode_version "$raw")"
    echo "opencode installed: ${ver:-$raw}"
  else
    echo "opencode installed: (not found)"
  fi
}

cmd_doctor() {
  local ok=0
  local raw ver sim

  if command -v opencode >/dev/null 2>&1; then
    say "ok  opencode-binary: $(command -v opencode)"
    raw="$(opencode --version 2>&1 || true)"
    ver="$(parse_opencode_version "$raw")"
    if [[ "$ver" == "$OPENCODE_PIN" ]]; then
      say "ok  opencode-pin: $ver matches $OPENCODE_PIN"
    else
      printf '\033[31mFAIL\033[0m opencode-pin: got %s, need exact pin %s\n' "${ver:-$raw}" "$OPENCODE_PIN"
      ok=1
    fi
  else
    printf '\033[31mFAIL\033[0m opencode-binary: not on PATH — run ./install.sh (installs opencode-ai@%s)\n' "$OPENCODE_PIN"
    ok=1
  fi

  if sim="$(labwired_resolve_sim "$0")"; then
    export LABWIRED_CLI="$sim"
    say "ok  labwired-sim: $sim"
  else
    unset LABWIRED_CLI
    printf '\033[31mFAIL\033[0m labwired-sim: no simulator found on PATH\n'
    printf '     install: curl -fsSL https://labwired.com/install.sh | sh\n'
    printf '     or:      export LABWIRED_CLI=/path/to/labwired-simulator\n'
    printf '     or:      export LABWIRED_SIM=/path/to/labwired-simulator\n'
    printf '     note:    this agent launcher is never used as the simulator\n'
    ok=1
  fi

  if command -v npx >/dev/null 2>&1; then
    say "ok  npx: present (MCP uses npx -y @labwired/mcp)"
  else
    printf '\033[31mFAIL\033[0m npx: not found (Node/npm required for @labwired/mcp)\n'
    ok=1
  fi

  local cfg="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
  if [[ -f "$cfg/opencode.json" ]]; then
    say "ok  config: $cfg/opencode.json"
  else
    printf '\033[33mwarn\033[0m config: missing %s/opencode.json — run ./install.sh\n' "$cfg"
    ok=1
  fi

  local skill
  for skill in \
    verify-firmware diagnose-firmware inspect-evidence \
    board-bringup scaffold-firmware report-evidence
  do
    if [[ -f "$cfg/skills/$skill/SKILL.md" ]]; then
      say "ok  skill: $skill"
    else
      printf '\033[33mwarn\033[0m skill: missing %s/skills/%s — run ./install.sh\n' "$cfg" "$skill"
      ok=1
    fi
  done

  if [[ $ok -eq 0 ]]; then
    say "LabWired Firmware Agent ready."
    return 0
  fi
  printf '\nLabWired Firmware Agent not ready.\n'
  return 1
}

cmd_help() {
  if [[ -f "$ROOT/branding/banner.txt" ]]; then
    cat "$ROOT/branding/banner.txt"
    echo
  fi
  cat <<EOF
LabWired Firmware Agent — the easiest way to write firmware.
agent proposes · oracle disposes

Usage:
  labwired              Launch OpenCode with LabWired MCP + skills
  labwired doctor       Preflight OpenCode pin, simulator, MCP, skills
  labwired version      Print harness and OpenCode pin
  labwired assert-status <expected> [file]
                        Hard claim gate: read verify JSON from file or stdin;
                        exit 0 if status matches expected, 1 mismatch, 2 missing.
                        expected: model_verified|failed|inconclusive|unsupported
  labwired help         This help

Env:
  LABWIRED_MODEL_URL    OpenAI-compatible model base URL (default Ollama)
  LABWIRED_MODEL_KEY    API key for that endpoint
  LABWIRED_BUILDER_URL  Builder for compile + serial/register/gpio verify
  LABWIRED_CLI          Simulator binary name/path (resolved if set and exists)
  LABWIRED_SIM          Alternate simulator env (same rules as LABWIRED_CLI)
  OPENCODE_PIN          Expected opencode-ai version (default: ${OPENCODE_PIN})
  OPENCODE_CONFIG_DIR   Config root (default: ~/.config/opencode)

Simulator resolution (first match): LABWIRED_CLI, LABWIRED_SIM, labwired
(if not this agent), labwired-sim, labwired-cli — only names that exist.
Never defaults to a fictional binary.

This is a distribution layer only — no OpenCode fork.
Oracle contracts live in the LabWired platform; this repo only wires the agent.
EOF
}

cmd_assert_status() {
  local expected="${1:-}"
  local file="${2:-}"
  if [[ -z "$expected" ]]; then
    fail "usage: labwired assert-status <expected> [file]"
  fi
  # shellcheck source=lib/assert-status.sh
  source "$ROOT/lib/assert-status.sh"
  if [[ -n "$file" && "$file" != "-" ]]; then
    labwired_assert_status "$expected" <"$file"
  else
    labwired_assert_status "$expected"
  fi
}

case "${1:-}" in
  doctor)  shift; cmd_doctor "$@" ;;
  version|--version|-V) cmd_version ;;
  help|--help|-h) cmd_help ;;
  assert-status)
    shift
    cmd_assert_status "$@"
    ;;
  "")
    if ! command -v opencode >/dev/null 2>&1; then
      fail "'opencode' not found on PATH. Run ./install.sh first (pins opencode-ai@${OPENCODE_PIN})."
    fi
    if labwired_export_sim; then
      : # LABWIRED_CLI exported for MCP child
    else
      echo "labwired: warning — no simulator found; run/verify will fail." >&2
      echo "         install: curl -fsSL https://labwired.com/install.sh | sh" >&2
      echo "         or set LABWIRED_CLI / LABWIRED_SIM to the simulator binary." >&2
    fi
    # Config/skills live under ~/.config/opencode from install.sh
    exec opencode "$@"
    ;;
  *)
    # Pass through to opencode (e.g. labwired mcp list)
    if ! command -v opencode >/dev/null 2>&1; then
      fail "'opencode' not found on PATH. Run ./install.sh first."
    fi
    labwired_export_sim || true
    exec opencode "$@"
    ;;
esac
