#!/usr/bin/env bash
# LabWired Agent — one-liner install (fast, portable)
#
#   curl -fsSL https://labwired.com/install | bash
#   curl -fsSL https://labwired.com/install | bash -s -- --prefix /opt/labwired
#
# Windows:  irm 'https://labwired.com/install?win32=true' | iex
# WSL:      use this bash installer inside the distro
set -euo pipefail

if [[ "$(uname -s 2>/dev/null || true)" == MINGW* ]] \
  || [[ "$(uname -s 2>/dev/null || true)" == MSYS* ]]; then
  echo "labwired: on native Windows use PowerShell:" >&2
  echo "  irm 'https://labwired.com/install?win32=true' | iex" >&2
  exit 1
fi

REPO_SLUG="${LABWIRED_AGENT_REPO_SLUG:-LabWired/agent}"
REPO_URL="${LABWIRED_AGENT_REPO:-https://github.com/${REPO_SLUG}.git}"
REPO_REF="${LABWIRED_AGENT_REF:-main}"
PREFIX="${LABWIRED_HOME:-$HOME/.labwired}"
AGENT_HOME="${LABWIRED_AGENT_HOME:-$PREFIX/agent}"
# Fast path: skip PlatformIO venv (slow). Full stack: LABWIRED_INSTALL_PIO=1
export LABWIRED_INSTALL_PIO="${LABWIRED_INSTALL_PIO:-0}"

say() { printf '\033[36m==>\033[0m %s\n' "$1"; }
die() { printf 'labwired install: %s\n' "$1" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "need '$1' on PATH"; }

need curl
need bash
need tar

say "LabWired Agent — fast portable install"
say "prefix: $PREFIX  ref: $REPO_REF"

mkdir -p "$PREFIX"
export LABWIRED_HOME="$PREFIX"
export LABWIRED_AGENT_HOME="$AGENT_HOME"

_install_kit_from_tarball() {
  local url tmp top
  # codeload is faster than git clone for shallow kit
  url="https://codeload.github.com/${REPO_SLUG}/tar.gz/refs/heads/${REPO_REF}"
  if [[ "$REPO_REF" == v* || "$REPO_REF" == *.* ]]; then
    # tag-style
    url="https://codeload.github.com/${REPO_SLUG}/tar.gz/refs/tags/${REPO_REF}"
  fi
  say "downloading kit tarball (${REPO_REF})…"
  tmp="$(mktemp -d)"
  if ! curl -fsSL --retry 3 --connect-timeout 15 "$url" | tar -xz -C "$tmp" 2>/dev/null; then
    # try heads/main if tag failed
    url="https://codeload.github.com/${REPO_SLUG}/tar.gz/refs/heads/main"
    curl -fsSL --retry 3 --connect-timeout 15 "$url" | tar -xz -C "$tmp" || {
      rm -rf "$tmp"
      return 1
    }
  fi
  top="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -1)"
  [[ -n "$top" && -f "$top/install.sh" ]] || {
    rm -rf "$tmp"
    return 1
  }
  rm -rf "$AGENT_HOME"
  mkdir -p "$(dirname "$AGENT_HOME")"
  mv "$top" "$AGENT_HOME"
  rm -rf "$tmp"
  # drop .git if any — portable tree
  rm -rf "$AGENT_HOME/.git"
  say "kit ready (tarball)"
  return 0
}

_install_kit_from_git() {
  need git
  say "cloning kit via git…"
  if [[ -d "$AGENT_HOME/.git" ]]; then
    git -C "$AGENT_HOME" fetch --depth 1 origin "$REPO_REF" 2>/dev/null || true
    git -C "$AGENT_HOME" checkout -q FETCH_HEAD 2>/dev/null \
      || git -C "$AGENT_HOME" pull --ff-only 2>/dev/null || true
  else
    rm -rf "$AGENT_HOME"
    git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$AGENT_HOME" \
      || git clone --depth 1 "$REPO_URL" "$AGENT_HOME"
  fi
}

# Prefer tarball (no git required, faster). Git fallback.
if [[ -d "$AGENT_HOME" && -f "$AGENT_HOME/install.sh" && "${LABWIRED_FORCE_REINSTALL:-0}" != "1" ]]; then
  say "existing kit found — reinstalling into prefix"
else
  if ! _install_kit_from_tarball; then
    say "tarball failed — falling back to git"
    _install_kit_from_git
  fi
fi

[[ -f "$AGENT_HOME/install.sh" ]] || die "install.sh missing in $AGENT_HOME"
say "running installer (sim + probe; PIO off for speed)"
# Pass through user flags; ensure --full for tools unless --minimal
has_mode=0
for a in "$@"; do
  case "$a" in --full|--minimal) has_mode=1 ;; esac
done
if [[ "$has_mode" -eq 0 ]]; then
  exec bash "$AGENT_HOME/install.sh" --full "$@"
else
  exec bash "$AGENT_HOME/install.sh" "$@"
fi
