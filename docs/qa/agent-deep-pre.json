await page.evaluate('() => {\n    const chips = [...document.querySelectorAll(\'button\')].filter(b => /LED blink|OLED clock|Serial hello/i.test((b.textContent||\'\').trim()));\n    const ta = document.querySelector(\'textarea[aria-label="Message the Architect"]\');\n    const status = document.querySelector(\'[aria-label="architect status"]\')?.textContent;\n    // sessionStorage architect keys\n    const ss = {};\n    for (let i = 0; i < sessionStorage.length; i++) {\n      const k = sessionStorage.key(i);\n      if (k && /architect|agent|chat|labwired/i.test(k)) ss[k] = sessionStorage.getItem(k)?.slice(0, 200);\n    }\n    const lsGuest = localStorage.getItem(\'labwired:guest-id\');\n    // try detect clerk\n    const clerkish = !!(window.Clerk || document.querySelector(\'.cl-rootBox, .cl-userButtonTrigger\'));\n    return {\n      chips: chips.map(c => c.textContent.trim()),\n      hasTa: !!ta,\n      status,\n      ss,\n      lsGuest,\n      clerkish,\n      url: location.href,\n      // performance already-fetched agent?\n      perfAgent: performance.getEntriesByType(\'resource\').filter(e => /agent|api\\.labwired/.test(e.name)).map(e => ({name: e.name.slice(0,120), status: e.responseStatus, dur: Math.round(e.duration)})).slice(-20),\n    };\n  }');
