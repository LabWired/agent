        "title": "Open Web Console",
        "category": "LabWired"
      },
      {
        "command": "labwired.openLogs",
        "title": "Open CLI Logs",
        "category": "LabWired"
      },
      {
        "command": "labwired.showCliProcessOutput",
        "title": "Show CLI Process Output",
