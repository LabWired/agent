{
  "name": "labwired-vscode",
  "displayName": "LabWired",
  "description": "Embedder + twin: real multi-source import (netlist graph, BOM map, PDF/KiCad) → catalog-honest twin.",
  "version": "0.10.0",
  "compatibleCliVersion": "0.3.7",
  "publisher": "labwired",
  "license": "MIT",
  "icon": "media/labwired-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LabWired/agent"
  },
  "homepage": "https://labwired.com",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "firmware",
    "embedded",
    "labwired",
    "twin",
    "verify",
    "serial"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "labwired",
          "title": "LabWired",
          "icon": "media/labwired-mark.svg"
        }
      ],
      "panel": [
        {
          "id": "labwiredPanel",
          "title": "LabWired",
          "icon": "media/labwired-mark.svg"
        }
      ]
    },
    "views": {
      "labwired": [
        {
          "type": "webview",
          "id": "labwired.chat",
          "name": "Agent",
          "icon": "media/labwired-mark.svg"
        }
      ],
      "labwiredPanel": [
        {
          "type": "webview",
          "id": "labwired.serial",
          "name": "Monitor",
          "icon": "media/labwired-mark.svg"
        },
        {
          "type": "webview",
          "id": "labwired.plot",
          "name": "Plot",
          "icon": "media/labwired-mark.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "labwired.newBoard",
        "title": "New board… (from catalog)",
        "category": "LabWired",
        "icon": "$(circuit-board)"
      },
      {
