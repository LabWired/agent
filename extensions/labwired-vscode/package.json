      },
      {
        "command": "labwired.startGithubDaemon",
        "title": "Start GitHub Daemon…",
        "category": "LabWired"
      }
    ],
    "customEditors": [
      {
        "viewType": "labwired.schematicEditor",
        "displayName": "LabWired Schematic Viewer",
        "selector": [
          {
            "filenamePattern": "*.kicad_sch"
          },
          {
            "filenamePattern": "*.kicad_pcb"
          },
          {
            "filenamePattern": "*.kicad_pro"
          },
          {
            "filenamePattern": "*.sch"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "labwired.openChatInEditor",
          "group": "navigation@-1"
        }
      ],
      "view/title": [
        {
          "command": "labwired.newTab",
          "when": "view == labwired.chat",
          "group": "navigation@1"
        },
        {
          "command": "labwired.startAgent",
          "when": "view == labwired.chat",
          "group": "navigation@2"
        },
        {
          "command": "labwired.openSchematics",
          "when": "view == labwired.serial",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "labwired.openSchematicFile",
          "when": "resourceExtname =~ /\\.(kicad_sch|kicad_pcb|kicad_pro|sch)$/",
          "group": "navigation"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "labwiredGettingStarted",
        "title": "Get Started with LabWired",
        "description": "Same start-here as the CLI: login → doctor → agent → blink & prove on the twin.",
        "steps": [
          {
            "id": "installCli",
            "title": "Install the LabWired CLI",
            "description": "Workbench is chrome; the brain is `labwired` (OpenCode + packs + MCP).\n\n[Install CLI](command:labwired.installCli)",
            "media": {
              "image": "media/labwired-mark.svg",
              "altText": "LabWired"
            },
            "completionEvents": [
              "onCommand:labwired.installCli"
            ]
          },
          {
            "id": "login",
            "title": "Log in (hosted MCP + model)",
            "description": "Same device-code as `labwired login`. Session → `~/.labwired/session/cloud.json`.\n\n[Log in](command:labwired.login)",
            "media": {
              "image": "media/labwired-mark.svg",
              "altText": "LabWired"
            },
            "completionEvents": [
              "onCommand:labwired.login"
            ]
          },
          {
            "id": "doctor",
            "title": "Run doctor",
            "description": "Confirm CLI, packs (golden-path · bringup · prove · observe · desk-hw), and tools.\n\n[Run Doctor](command:labwired.doctor)",
            "media": {
              "image": "media/labwired-mark.svg",
              "altText": "LabWired"
            },
            "completionEvents": [
              "onCommand:labwired.doctor"
            ]
          },
          {
            "id": "startAgent",
            "title": "Start Agent (OpenCode)",
            "description": "Opens a terminal and runs bare `labwired` — prepare skills + golden-path + shared labwired_* tools.\n\n[Start Agent](command:labwired.startAgent)",
            "media": {
              "image": "media/labwired-mark.svg",
              "altText": "LabWired"
            },
            "completionEvents": [
              "onCommand:labwired.startAgent"
            ]
          },
          {
            "id": "prove",
            "title": "Blink & prove on the twin",
            "description": "In the Agent chat: *Blink the LED and prove it on the twin.* Green only after twin verify — LabWired’s wedge vs plain agent UIs.\n\n[Open Agent](command:labwired.openChat)",
            "media": {
              "image": "media/labwired-mark.svg",
              "altText": "LabWired"
            },
            "completionEvents": [
              "onCommand:labwired.openChat"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "LabWired",
      "properties": {
        "labwired.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the labwired CLI. Empty = auto-detect."
        },
        "labwired.autoInstallCli": {
          "type": "boolean",
          "default": true,
          "description": "Prompt to install the LabWired CLI when not found."
        },
        "labwired.autoRevealOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Reveal LabWired Agent view on activation."
        },
        "labwired.inPanelLlm": {
          "type": "boolean",
          "default": false,
          "description": "When true, freeform chat uses in-panel LLM (OpenCode/Ollama). Default false: freeform starts the CLI agent terminal (recommended — Embedder-like single path)."
        },
        "labwired.showSerial": {
          "type": "boolean",
          "default": false,
          "description": "Show the Monitor panel on activation (default off — open via LabWired: Open Monitor)."
        },
        "labwired.showReasoningSummaries": {
          "type": "boolean",
          "default": true,
          "description": "Show reasoning summaries in chat when the agent provides them."
        },
        "labwired.closeAgentChatOnActivation": {
          "type": "boolean",
          "default": false,
          "description": "Try to close the built-in VS Code/Cursor agent chat when LabWired activates."
        },
        "labwired.moveChatToSecondarySidebarOnActivation": {
          "type": "boolean",
          "default": false,
          "description": "Prefer secondary side bar layout when supported."
        },
        "labwired.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "Allow anonymized telemetry (off by default; LabWired does not ship Sentry in OSS)."
        },
        "labwired.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Extension log verbosity (Output → LabWired)."
        },
        "labwired.defaultBaud": {
          "type": "number",
          "default": 115200,
          "description": "Default serial baud rate."
        },
        "labwired.agentArgs": {
          "type": "string",
          "default": "",
          "description": "Extra args when starting the agent terminal."
        },
        "labwired.appUrl": {
          "type": "string",
          "default": "https://app.labwired.com",
          "description": "Web console / billing base URL."
        },
        "labwired.installUrl": {
          "type": "string",
          "default": "https://labwired.com/install",
          "description": "CLI install script URL (curl | bash)."
        },
        "labwired.model": {
          "type": "string",
          "default": "qwen2.5-coder",
          "description": "Model id for in-panel agent (OpenAI-compatible)."
        },
        "labwired.modelUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434/v1",
          "description": "OpenAI-compatible base URL (Ollama default)."
        },
        "labwired.modelKey": {
          "type": "string",
          "default": "local",
          "description": "API key for modelUrl (local for Ollama)."
        },
        "labwired.team": {
          "type": "string",
          "default": "",
          "description": "Active team name/id for Pro."
        },
        "labwired.project": {
          "type": "string",
          "default": "",
          "description": "Active project name/id for Pro."
        },
        "labwired.autoStartRpc": {
          "type": "boolean",
          "default": false,
          "description": "Start labwired --server RPC on activation (off by default; freezes less, CLI agent is primary)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies -o labwired-vscode.vsix && npm run check:vsix",
    "vscode:prepublish": "npm run compile",
    "check:vsix": "python3 scripts/check-vsix-integrity.py",
    "check:cli": "npm run compile && node scripts/check-cli-contract.mjs && node scripts/check-board-mint.mjs && node scripts/check-import-e2e.mjs && node scripts/check-composed-plot.mjs",
    "check": "npm run check:cli && npm run package",
    "test:ship": "npm run compile && node ./out/test/runTest.js",
    "check:mint": "npm run compile && node scripts/check-board-mint.mjs",
    "check:import": "npm run compile && node scripts/check-import-e2e.mjs"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3"
  }
}
